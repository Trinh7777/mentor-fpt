# =========================================================================
# CẤU HÌNH HỆ THỐNG UNIFS PRO 2.0 (SAO CHÉP THÀNH FILE .env NẾU CẦN)
# Hệ thống cũng tự động đọc GEMINI_API_KEY từ .streamlit/secrets.toml
# =========================================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AUTH_SECRET_KEY=unifs-fpt-vip-pro-secret-2026

# (Tùy chọn) Gửi mã OTP 6 số thật qua Gmail SMTP khi sinh viên Quên mật khẩu.
# Nếu để trống, giao diện sẽ tự động bật "Hộp thư OTP Trực quan (Demo Mode)" rất tiện khi demo/bảo vệ đồ án!
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# (Tùy chọn) PostgreSQL / Supabase URL (Mặc định dùng SQLite tại data/mentor_fpt.db)
DATABASE_URL=

# (Tùy chọn) Telegram Bot Token
TELEGRAM_BOT_TOKEN=
