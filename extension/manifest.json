{
  "manifest_version": 3,
  "name": "UniFs Pro — FAP Parallel Crawler & AI Copilot",
  "version": "2.0.0",
  "description": "Tự động kéo song song 5 luồng dữ liệu từ fap.fpt.edu.vn (Hồ sơ, Bảng điểm, Điểm TP, TKB, Điểm danh đa môn) & mở Trợ lý AI ngay trên FAP.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://fap.fpt.edu.vn/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "copilot.html",
    "default_title": "UniFs Pro — FAP AI Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "copilot.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fap.fpt.edu.vn/*",
        "http://localhost:8000/fap-simulator/*",
        "http://127.0.0.1:8000/fap-simulator/*"
      ],
      "js": [
        "fap_page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://fap.fpt.edu.vn/*",
        "http://localhost:8000/fap-simulator/*",
        "http://127.0.0.1:8000/fap-simulator/*"
      ],
      "js": [
        "fap_crawler.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "copilot.html",
        "dist/*",
        "icons/*"
      ],
      "matches": [
        "https://fap.fpt.edu.vn/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ]
    }
  ]
}
